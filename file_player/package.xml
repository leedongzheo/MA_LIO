<?xml version="1.0"?>
<package format="3">
  <name>file_player</name>
  <version>0.1.0</version>
  <description>ROS2 Jazzy file player for MA_LIO datasets.</description>

  <maintainer email="jjy0923@kaist.ac.kr">jjy0923</maintainer>
  <license>TODO</license>
  <url type="website">http://irap.kaist.ac.kr</url>
  <author email="jjy0923@kaist.ac.kr">Jinyong Jeong</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_srvs</depend>
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_msgs</depend>
  <depend>irp_sen_msgs</depend>
  <depend>livox_ros_driver</depend>
  <depend>camera_info_manager</depend>

  <exec_depend>qtbase5-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
